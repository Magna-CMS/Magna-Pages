{
    "name": "magna/pages",
    "displayName": "Magna Pages",
    "description": "Turns a headless Magna install into a rendered website: pages, templates, menus, and the visual site builder.",
    "version": "0.1.0",
    "author": "Magna Team",
    "license": "proprietary",
    "compat": {
        "magna": "^1.0",
        "php": "^8.3"
    },
    "entry": "Magna\\Pages\\PagesPlugin",
    "provides": {
        "settingsPages": true,
        "adminNavigation": true,
        "contentTypes": ["page", "pages_template"]
    },
    "permissions": [
        "pages.content",
        "pages.layout",
        "pages.design",
        "pages.publish",
        "pages.settings"
    ],
    "uninstall": {
        "tables": [
            "magna_entries_page",
            "magna_entries_pages_template",
            "pages_redirects",
            "pages_menus",
            "pages_menu_items",
            "pages_menu_revisions",
            "pages_cache",
            "pages_cache_keys",
            "pages_document_locks",
            "pages_patterns",
            "pages_global_styles",
            "pages_style_revisions",
            "pages_publish_requests",
            "pages_comments",
            "pages_changesets",
            "pages_changeset_items",
            "pages_experiment_stats",
            "pages_style_schedules"
        ],
        "contentTypes": ["page", "pages_template"]
    }
}
